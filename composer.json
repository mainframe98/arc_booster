{
  "name": "mainframe98/arc_booster",
  "type": "php-ext",
  "description": "Arc Booster is a PHP extension aiming to speed up performance of Arcanist, and by extension, Phorge.",
  "license": "MIT",
  "keywords": [
    "arcanist",
    "phorge",
    "phabricator"
  ],
  "readme": "Readme.md",
  "authors": [
    {
      "name": "mainframe98",
      "email": "mainframe98@outlook.com"
    }
  ],
  "require": {
    "php": ">= 8.4"
  },
  "php-ext": {
    "extension-name": "arc_booster",
    "configure-options": [
      {
        "name": "enable-arc_booster",
        "needs-value": false,
        "description": "Whether to enable arc_booster support"
      }
    ]
  }
}

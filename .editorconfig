# https://editorconfig.org/
root = true
# 2 space indentation (no size specified)
[*]
charset = utf-8
indent_style = tab
end_of_line = lf
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
[*.{md,php,phpt}]
indent_size = 2
indent_style = space
[*.{m4,yml}]
indent_size = 2
indent_style = space
